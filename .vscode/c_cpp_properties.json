{
  "configurations": [
    {
      "name": "STM32F103",
      // 用通配符把整个工程目录都扫进来。
      // 好处是不管工程叫 User 还是 Hardware 还是别的名字，IntelliSense 都能找到头文件
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "USE_STDPERIPH_DRIVER",
        "STM32F10X_MD"
      ],
      "compilerPath": "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/14.2 rel1/bin/arm-none-eabi-gcc.exe",
      "compilerArgs": [
        "-mcpu=cortex-m3",
        "-mthumb"
      ],
      "cStandard": "gnu11",
      "intelliSenseMode": "gcc-arm",
      "browse": {
        "path": [
          "${workspaceFolder}"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
